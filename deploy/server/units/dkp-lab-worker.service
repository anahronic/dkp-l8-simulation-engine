[Unit]
Description=DKP Lab serial worker
After=network.target dkp-lab-api.service

[Service]
Type=simple
User=dkplab
Group=dkplab
WorkingDirectory=/opt/dkp-lab/current
ExecStart=/opt/dkp-lab/current/venv/bin/python -m lab_server.worker --db /var/lib/dkp-lab/lab/jobs.sqlite3 --store /var/lib/dkp-lab/lab/store
Environment=PYTHONDONTWRITEBYTECODE=1
MemoryMax=600M
CPUQuota=60%
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dkp-lab
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
